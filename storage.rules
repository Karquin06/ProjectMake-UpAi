rules_version = '2';

// Reglas de Firebase Storage — proyecto macke-up-ai.
// Se publican con: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function logueada() { return request.auth != null; }
    function esDuena(uid) { return logueada() && request.auth.uid == uid; }
    function esAdmin() { return logueada() && request.auth.token.get('admin', false) == true; }
    function imagenValida() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Foto de perfil (Karlos / Jaider): la dueña la sube y solo ella (o la
    // admin) la ve; ninguna pantalla muestra fotos de otras usuarias (H-08).
    // eliminarCuenta borra la carpeta con Admin SDK.
    match /perfiles/{uid}/{archivo} {
      allow read: if esDuena(uid) || esAdmin();
      allow create, update: if esDuena(uid) && imagenValida();
      allow delete: if esDuena(uid);
    }

    // Fotos del catálogo (Ana): solo la cuenta admin las sube o borra.
    match /catalogo/{carpeta}/{id}/{archivo} {
      allow read: if logueada();
      allow create, update: if esAdmin()
                            && carpeta in ['prendas', 'productos']
                            && imagenValida();
      allow delete: if esAdmin();
    }

    // H-03: la admin de una marca solo si la marca sigue activa y su correo
    // sigue en `admins` (consulta a Firestore desde las reglas de Storage).
    function esAdminMarcaVigente(marcaId) {
      return logueada()
          && request.auth.token.get('marcaId', null) == marcaId
          && firestore.exists(/databases/(default)/documents/marcas/$(marcaId))
          && firestore.get(/databases/(default)/documents/marcas/$(marcaId)).data.get('activa', true) == true
          && request.auth.token.get('email', '') in
               firestore.get(/databases/(default)/documents/marcas/$(marcaId)).data.get('admins', []);
    }

    // Fotos de productos de una marca y su logo (Ana): la admin general o la
    // admin vigente de esa marca.
    match /catalogo/marcas/{marcaId}/{id}/{archivo} {
      allow read: if logueada();
      allow create, update: if (esAdmin() || esAdminMarcaVigente(marcaId))
                            && imagenValida();
      allow delete: if esAdmin() || esAdminMarcaVigente(marcaId);
    }

    // Temporales para análisis con Cloud Functions (selfies y prendas).
    // Las funciones los leen y borran con Admin SDK; limpiarImagenesTemporales
    // borra los que tengan más de una hora.
    match /temporales/{tipo}/{uid}/{archivo} {
      allow create: if esDuena(uid)
                    && tipo in ['selfies', 'prendas']
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';
      allow delete: if esDuena(uid);
      allow read: if false;
    }
  }
}
